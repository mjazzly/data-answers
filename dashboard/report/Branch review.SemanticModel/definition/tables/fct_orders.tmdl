		sourceColumn: export_batch

		annotation SummarizationSetBy = Automatic

	partition fct_orders = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(RepoPath & "\dashboard\data\fct_orders.parquet")),
				    BatchOne = Table.SelectRows(Source, each [export_batch] = 1),
				    Typed = Table.TransformColumnTypes(BatchOne, {{"order_value", Currency.Type}})
				in
				    Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

