model Model
	culture: en-SG
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-MY
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["RepoPath","fct_orders","month_axis"]

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

ref table fct_orders
ref table month_axis

ref cultureInfo en-SG

